# API port (frontend runs on 3000)
PORT=3001

# Comma-separated list of origins allowed by CORS
FRONTEND_URL=http://localhost:3000

# Matches docker-compose.yml
DATABASE_URL=postgresql://leilao:leilao@localhost:5432/leilao

# Secret used to sign login tokens (min. 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
# Token lifetime in seconds (default: 86400 = 1 day)
JWT_EXPIRES_IN_SECONDS=86400

# Max login/register attempts per IP per minute
AUTH_RATE_LIMIT=10
